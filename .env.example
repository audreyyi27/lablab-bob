# GitHub OAuth App (https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_oauth_app_client_id
GITHUB_CLIENT_SECRET=your_github_oauth_app_client_secret

# Must match the Authorization callback URL in your GitHub OAuth app
GITHUB_CALLBACK_URL=http://localhost:3000/api/auth/github/callback

# Where users land after OAuth (usually same as server origin)
FRONTEND_URL=http://localhost:3000

# Random string for signing session cookies (change in production)
SESSION_SECRET=replace-with-a-long-random-string

PORT=3000

# IBM watsonx.ai Configuration
# Get your API key from: https://cloud.ibm.com/iam/apikeys
WATSONX_API_KEY=your_watsonx_api_key

# Required for AI document generation (Analyze page) — NOT the same as Orchestrate URL below.
# IBM Cloud → watsonx.ai → open a project → Manage → copy "Project ID"
WATSONX_PROJECT_ID=your_watsonx_project_id

# Region where your watsonx.ai project lives (match your IBM Cloud region, e.g. eu-de)
WATSONX_REGION=us-south

# Model to use for generation (e.g., ibm/granite-13b-chat-v2, meta-llama/llama-3-70b-instruct)
WATSONX_MODEL_ID=ibm/granite-13b-chat-v2

# Vercel deploy provider (https://vercel.com/account/tokens)
# Required for the Continuous Delivery panel to ship real production builds.
VERCEL_TOKEN=your_vercel_token
# Optional: a Vercel team id; omit if deploying under your personal account.
VERCEL_TEAM_ID=
